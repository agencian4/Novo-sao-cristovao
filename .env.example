# Copiar para o painel da Vercel (Settings > Environment Variables). Nunca commitar valores reais.
N4FLOW_URL=https://<endereco-do-flow>/api/integrations/forms
N4FLOW_AUTH_HEADER=X-N4-Form-Key
N4FLOW_AUTH_VALUE=
LEAD_FALLBACK_URL=

# Mapa da seção de localização. Com a chave (Maps Embed API, gratuita), mostra a rota da VI GERES até o acesso.
# Sem ela, mostra só o pin. Restringir a chave aos domínios da landing no Google Cloud.
GOOGLE_MAPS_EMBED_KEY=
